{
  // npm run typecheck (tools/typecheck.mjs). TypeScript only reads the files: no build step, nothing the browser loads changes.
  // checkJs: every file in js/ is checked, a new one too (Nov 21, code-health plan step 8; each file also starts with
  // // @ts-check, for editors). Shared shapes live in js/types.js (JSDoc @typedef only).
  // types/*.d.ts: browser APIs TypeScript's DOM types don't have yet (Web Bluetooth).
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "types": []
  },
  "include": ["js/**/*.js", "types/*.d.ts"]
}
