  "name": "Ramp FTP test",
  "tags": [
    "test"
  ],
  "description": "Zwift-style ramp: 1-minute steps from 100 W, +20 W every minute, with no top step. The test ends itself when you can't hold the target (or hold B), the coach gives you the result and the cool-down starts. FTP = 75% of your best minute, with a button on the summary to apply it.",
  "steps": [
    {
      "dur": 300,
      "power": 0.5,
      "label": "Easy spin",
      "messages": [
        {
          "text": "Ramp test today. Easy spin for the first 5 minutes."
        },
        {
          "at": 25,
          "text": "Then 1-minute steps from 100 W, +20 W every minute."
        },
        {
          "at": 70,
          "text": "Go until you truly can't hold the target. The test ends itself."
        },
        {
          "at": 125,
          "text": "Your new FTP is 75% of your best minute."
        },
        {
          "at": 185,
          "text": "Stay seated the whole way. Cadence 90 to 100."
        },
        {
          "at": -40,
          "text": "Is the FR970 recording? Start it now if not."
        }
      ]
    },
    {
      "dur": 120,
      "power": 0.5,
      "messages": [
