    {
      "dur": 600,
      "grade": 1,
      "label": "Warm-up roll",
      "messages": [
        {
          "text": "MTB climbs: 4 x 6 min at 7%."
        },
        {
          "at": 30,
          "text": "On the climbs: big gear, 60-65 rpm, seated."
        },
        {
          "at": 100,
          "text": "Aim for about 90% FTP on the power card."
        },
        {
          "at": -20,
          "text": "First climb in 20 seconds. Shift to a big gear."
        }
      ]
    },
    {
      "repeat": 4,
      "steps": [
        {
          "dur": 360,
          "grade": 7,
          "cadence": "60-65",
          "label": "Climb",
          "text": "Big gear, seated, ~90% FTP",
          "messages": [
            {
              "text": "Climb {rep} of {of}. Big gear, 60-65 rpm."
            },
            {
              "at": 60,
              "rep": [
                1,
                2
              ],
              "text": "Stay seated. Push through the whole pedal stroke."
            },
            {
              "at": "50%",
              "text": "Halfway up. Keep the torque on."
            },
            {
              "at": -60,
              "text": "One minute to the top."
            },
            {
              "at": -15,
              "rep": "last",
              "text": "Last 15 seconds of the last climb!"
            }
          ]
        },
        {
          "dur": 240,
          "grade": 0,
          "label": "Flat roll",
          "messages": [
            {
              "rep": [
                1,
                2,
                3
              ],
              "text": "Over the top. Shift down and spin easy."
            },
            {
              "at": -20,
              "rep": [
                1,
                2,
                3
              ],
              "text": "Next climb in 20 seconds. Big gear ready."
            },
            {
              "rep": "last",
              "text": "All climbs done. Nice work."
            }
          ]
        }
      ]
    },
    {
      "dur": 300,
      "grade": 0,
      "label": "Cool-down",
      "messages": [
        {
          "text": "Cool-down. Easy spin, then save the ride."
        }
      ]
    }
  ]
